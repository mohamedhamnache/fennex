# Database
DATABASE_URL=postgresql://fennex:fennex@localhost:5432/fennex
REDIS_URL=redis://localhost:6379/0

# Auth
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# Encryption (for API keys at rest)
ENCRYPTION_KEY=change-me-32-bytes-base64-encoded==

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXTAUTH_URL=http://localhost:3001
NEXTAUTH_SECRET=change-me-in-production

# Optional: Storage (S3-compatible)
# S3_BUCKET=fennex-assets
# S3_REGION=us-east-1
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_ENDPOINT_URL=

# Optional: Email
# SENDGRID_API_KEY=
# FROM_EMAIL=noreply@fennex.ai

# Stripe Billing
# Price IDs are server-side only: the checkout endpoint resolves them, so no
# NEXT_PUBLIC_STRIPE_PRICE_* vars are needed and none should be added.
# Each Stripe price must also carry a lookup_key of "<tier>_monthly" or
# "<tier>_annual" -- the webhook maps subscriptions back to a plan by that key,
# not by price ID, and a missing key silently leaves the org on its old plan.
# scripts/stripe-setup.sh creates all of these with the right keys.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_STARTER_MONTHLY=price_...
STRIPE_PRICE_STARTER_ANNUAL=price_...
STRIPE_PRICE_PRO_MONTHLY=price_...
STRIPE_PRICE_PRO_ANNUAL=price_...
STRIPE_PRICE_AGENCY_MONTHLY=price_...
STRIPE_PRICE_AGENCY_ANNUAL=price_...
STRIPE_PRICE_SCALE_MONTHLY=price_...
STRIPE_PRICE_SCALE_ANNUAL=price_...

# AI Image Services
# Replicate — image-conditioned generation (Product tab, flux-kontext-pro)
# Get token at: replicate.com → Account → API tokens
# REPLICATE_API_KEY=r8_...

# Remove.bg — background removal (AI editing tools)
# Get key at: remove.bg/api
# REMOVE_BG_API_KEY=...

# Google OAuth (for Search Console integration)
# Create credentials at https://console.cloud.google.com/apis/credentials
# Set the authorized redirect URI to: http://localhost:8000/api/v1/analytics/gsc/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/analytics/gsc/callback

# Shopify OAuth ("Connect with Shopify" one-click install)
# Create ONE Fennex-owned app at https://dev.shopify.com, set its redirect URL to
# the callback below, and copy the app's Client ID + Secret here. When these are
# set, the Integrations page shows a one-click "Connect with Shopify" button;
# otherwise it falls back to manual client-credentials entry.
# SHOPIFY_APP_CLIENT_ID=
# SHOPIFY_APP_CLIENT_SECRET=
# read_orders/read_analytics power revenue attribution. Request them BEFORE the
# first merchant connects -- adding a scope later forces every store to re-auth.
# SHOPIFY_APP_SCOPES=read_products,write_products,write_files,read_orders,read_analytics
# SHOPIFY_REDIRECT_URI=http://localhost:8000/api/v1/shopify/oauth/callback
# FRONTEND_URL=http://localhost:3001

# --- Platform (reseller) provider credentials ---
# At least ONE platform LLM key is REQUIRED (users no longer bring their own keys).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
# DataForSEO (platform SEO account)
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
# Staff who can manage provider accounts. JSON array form (pydantic-settings):
# PLATFORM_ADMIN_EMAILS=["ops@fennex.ai","admin@fennex.ai"]
PLATFORM_ADMIN_EMAILS=[]

# Admin console (apps/admin) — first-run bootstrap super-admin.
# On first login with these exact credentials (when the admin_user table is
# empty) a super-admin is created. Leave blank to disable bootstrap.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
# Add the admin app origin (dev: http://localhost:3002) to CORS_ORIGINS, e.g.
# CORS_ORIGINS=["http://localhost:3000","http://localhost:3001","http://localhost:3002"]
